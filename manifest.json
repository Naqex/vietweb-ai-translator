{
  "manifest_version": 3,
  "name": "VietWeb AI Translator — CLIProxyAPI",
  "short_name": "VietWeb AI",
  "version": "1.4.3",
  "version_name": "1.4.3-cache-reuse",
  "description": "Dịch trang web sang tiếng Việt qua CLIProxyAPI: hiển thị theo luồng (streaming), ưu tiên vùng nhìn thấy, giao diện kiểu Apple.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VietWeb AI Translator",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html"
}
